---
layout: compress
swcache: true
---

[
  {%- assign articles = "" | split: "" -%}
  {%- assign glossary_items = "" | split: "" -%}

  {%- for post in site.posts -%}
    {%- capture item -%}
      {
        "title": {{ post.title | jsonify }},
        "url": {{ post.url | relative_url | jsonify }},
        "categories": {{ post.categories | join: ', ' | jsonify }},
        "tags": {{ post.tags | join: ', ' | jsonify }},
        "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
        "lang": {{ post.lang | default: "en" | jsonify }},
        {%- if post.categories contains 'glossary' or post.categories contains 'glosario' -%}
          "type": "glossary",
        {%- else -%}
          "type": "article",
        {%- endif -%}
        "content": {{ post.content | strip_html | strip_newlines | replace: 'The Theory (The What)', '' | replace: 'The Theory (El Qué)', '' | replace: 'The Senior Nuance', '' | replace: 'The Senior Nuance (El Matiz Senior)', '' | replace: 'The Senior Perspective (The Why)', '' | replace: 'The Senior Perspective (El Porqué)', '' | replace: 'Code in Action', '' | replace: 'The Interview (The Hot Seat)', '' | replace: 'The Interview (En el banquillo)', '' | replace: '## ', '' | replace: '# ', '' | replace: '### ', '' | replace: '**', '' | truncate: 200 | jsonify }}
      }
    {%- endcapture -%}
    {%- if post.categories contains 'glossary' or post.categories contains 'glosario' -%}
      {%- assign glossary_items = glossary_items | push: item -%}
    {%- else -%}
      {%- assign articles = articles | push: item -%}
    {%- endif -%}
  {%- endfor -%}

  {%- for page in site.pages -%}
    {%- assign is_chapter_index = false -%}
    {%- for lang_key in site.data.translations -%}
      {%- for ch in lang_key[1].chapters -%}
        {%- if page.url == ch.url -%}
          {%- assign is_chapter_index = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if page.title and page.url != "/" and is_chapter_index == false -%}
      {%- capture item -%}
        {
          "title": {{ page.title | jsonify }},
          "url": {{ page.url | relative_url | jsonify }},
          "categories": "",
          "tags": "",
          "date": "",
          {%- if page.url contains '/es/' -%}
            "lang": "es",
          {%- else -%}
            "lang": "en",
          {%- endif -%}
          {%- if page.url contains '/glossary/' or page.url contains '/glosario/' -%}
            "type": "glossary",
          {%- else -%}
            "type": "article",
          {%- endif -%}
          "content": {{ page.content | strip_html | strip_newlines | replace: 'The Theory (The What)', '' | replace: 'The Theory (El Qué)', '' | replace: 'The Senior Nuance', '' | replace: 'The Senior Nuance (El Matiz Senior)', '' | replace: 'The Senior Perspective (The Why)', '' | replace: 'The Senior Perspective (El Porqué)', '' | replace: 'Code in Action', '' | replace: 'The Interview (The Hot Seat)', '' | replace: 'The Interview (En el banquillo)', '' | replace: '## ', '' | replace: '# ', '' | replace: '### ', '' | replace: '**', '' | truncate: 200 | jsonify }}
        }
      {%- endcapture -%}
      {%- if page.url contains '/glossary/' or page.url contains '/glosario/' -%}
        {%- assign glossary_items = glossary_items | push: item -%}
      {%- else -%}
        {%- assign articles = articles | push: item -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- for item in articles -%}
    {{ item }},{%- endfor -%}
  {%- for item in glossary_items -%}
    {{ item }}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
